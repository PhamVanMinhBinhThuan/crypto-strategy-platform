# Placeholder values only. Copy names into an untracked local environment.
DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
DATABASE_USERNAME=<server-username>
DATABASE_PASSWORD=<server-password>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SENTIMENT_BUNDLE_PATH=<path-to-sentiment-bundle>
SENTIMENT_SERVICE_TOKEN=<service-token>
SENTIMENT_MODEL_NAME=multichannel-english
SENTIMENT_MODEL_VERSION=multichannel-english-1.0.0
SENTIMENT_PREPROCESSING_VERSION=multichannel-whitespace-en-1
NEWS_ENABLED=true
NEWS_AUDIT_SERVICE_TOKEN=<audit-service-token>
