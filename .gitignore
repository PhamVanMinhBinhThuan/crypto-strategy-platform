.gradle/
**/build/
**/bin/
/out/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE, operating-system and temporary files.
.idea/
.vscode/
*.iml
*.log
.DS_Store
Thumbs.db
*.tmp
*.swp
__pycache__/
*.py[cod]
.venv/
.venv-f014-sentiment/
venv/
dist/
*.egg-info/
.pytest_cache/
node_modules/

# Ignore every local environment file except the committed placeholder template.
.env*
!.env.example
